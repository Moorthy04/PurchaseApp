        },
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse\",\n  \"item_type_id\": 1,\n  \"purchase_date\": \"2026-08-25\",\n  \"stock_available\": 20,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/items/", "host": ["{{baseUrl}}"], "path": ["items", ""] }
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Mouse V2\",\n  \"item_type_id\": 1,\n  \"purchase_date\": \"2026-08-25\",\n  \"stock_available\": 25,\n  \"active\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/items/1/", "host": ["{{baseUrl}}"], "path": ["items", "1", ""] }
          }
        },
        {
          "name": "Delete Item (Conflict if used in purchase)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/items/1/", "host": ["{{baseUrl}}"], "path": ["items", "1", ""] }
          }
        }
      ]
    },
