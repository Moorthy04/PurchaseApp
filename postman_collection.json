      "name": "Item Types",
      "item": [
        {
          "name": "Get All Item Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/item-types/", "host": ["{{baseUrl}}"], "path": ["item-types", ""] }
          }
        },
        {
          "name": "Create Item Type",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type_name\": \"Stationery\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/item-types/", "host": ["{{baseUrl}}"], "path": ["item-types", ""] }
          }
        },
        {
          "name": "Update Item Type",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type_name\": \"Office Stationery\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/item-types/1/", "host": ["{{baseUrl}}"], "path": ["item-types", "1", ""] }
          }
        },
        {
          "name": "Delete Item Type (Conflict if items exist)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/item-types/1/", "host": ["{{baseUrl}}"], "path": ["item-types", "1", ""] }
          }
        }
      ]
    },
    {
