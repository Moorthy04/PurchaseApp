              "raw": "{\n  \"purchase_date\": \"2026-08-26\",\n  \"items\": [\n    {\n      \"item_id\": 1,\n      \"quantity\": 3\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/purchases/1/", "host": ["{{baseUrl}}"], "path": ["purchases", "1", ""] }
